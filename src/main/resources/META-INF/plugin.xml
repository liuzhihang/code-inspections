<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <!-- Unique identifier of the plugin. It should be FQN. It cannot be changed between the plugin versions. -->
    <id>com.liuzhihang.code.inspections</id>
    <vendor email="liuzhihangs@qq.com" url="https://liuzhihang.com">Liu ZhiHang</vendor>

    <!-- Public plugin name should be written in Title Case.
         Guidelines: https://plugins.jetbrains.com/docs/marketplace/plugin-overview-page.html#plugin-name -->
    <name>CodeInspections</name>

    <!-- Product and plugin compatibility requirements.
         Read more: https://plugins.jetbrains.com/docs/intellij/plugin-compatibility.html -->
    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.java</depends>

    <!-- Extension points defined by the plugin.
         Read more: https://plugins.jetbrains.com/docs/intellij/plugin-extension-points.html -->
    <extensions defaultExtensionNs="com.intellij">

        <!-- Concurrency -->
        <!-- 【强制】自定义的 ThreadLocal 变量必须回收，尤其是在使用线程池时，因为线程经常被复用。否则可能会影响后续业务逻辑，并导致内存泄漏等意外问题。 -->
        <localInspection language="JAVA" groupPath="Ali-P3C" groupName="Concurrency" enabledByDefault="true" level="WARNING"
                         bundle="bundle.CodeInspectionsBundle" key="ali.p3c.concurrent.ThreadLocalShouldRemoveInspectionTool.key"
                         implementationClass="com.code.inspections.ali.concurrent.ThreadLocalShouldRemoveInspectionTool"/>
        <!-- 【强制】有意义的线程名称有助于追踪错误信息，因此，在创建线程或线程池时，请指定一个名称。 -->
        <localInspection language="JAVA" groupPath="Ali-P3C" groupName="Concurrency" enabledByDefault="true" level="WARNING"
                         bundle="bundle.CodeInspectionsBundle" key="ali.p3c.concurrent.ThreadShouldSetNameInspectionTool.key"
                         implementationClass="com.code.inspections.ali.concurrent.ThreadShouldSetNameInspectionTool"/>
        <!-- 【强制】线程资源必须通过线程池提供，不允许在应用中自行显式创建线程。  -->
        <localInspection language="JAVA" groupPath="Ali-P3C" groupName="Concurrency" enabledByDefault="true" level="WARNING"
                         bundle="bundle.CodeInspectionsBundle" key="ali.p3c.concurrent.AvoidManuallyCreateThreadInspectionTool.key"
                         implementationClass="com.code.inspections.ali.concurrent.AvoidManuallyCreateThreadInspectionTool"/>
        <!-- 【强制】线程池应该使用 ThreadPoolExecutor 而不是 Executors 来创建。 -->
        <localInspection language="JAVA" groupPath="Ali-P3C" groupName="Concurrency" enabledByDefault="true" level="WARNING"
                         bundle="bundle.CodeInspectionsBundle" key="ali.p3c.concurrent.ThreadPoolCreationInspectionTool.key"
                         implementationClass="com.code.inspections.ali.concurrent.ThreadPoolCreationInspectionTool"/>
        <!-- 【强制】 SimpleDateFormat 是线程不安全的类，一般不要定义为 static 变量，如果定义为 static，必须加锁，或者使用 DateUtils 工具类。  -->
        <localInspection language="JAVA" groupPath="Ali-P3C" groupName="Concurrency" enabledByDefault="true" level="WARNING"
                         bundle="bundle.CodeInspectionsBundle" key="ali.p3c.concurrent.AvoidCallStaticSimpleDateFormatInspectionTool.key"
                         implementationClass="com.code.inspections.ali.concurrent.AvoidCallStaticSimpleDateFormatInspectionTool"/>
        <!-- Collection -->

        <!-- Naming Conventions -->

        <!-- Constant Conventions -->

        <!-- OOP -->

        <!-- Flow Control Statements -->

        <!-- Exception -->

        <!-- Code Comments -->
        <localInspection language="JAVA" groupPath="Ali-P3C" groupName="Naming" enabledByDefault="true" level="ERROR"
                         bundle="bundle.CodeInspectionsBundle" key="ali.p3c.naming.AvoidStartWithDollarAndUnderLineNamingInspectionTool.key"
                         implementationClass="com.code.inspections.ali.naming.AvoidStartWithDollarAndUnderLineNamingInspectionTool"/>

        <!-- Other -->


    </extensions>
</idea-plugin>